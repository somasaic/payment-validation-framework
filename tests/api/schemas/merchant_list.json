{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MerchantList",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "total",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/merchant"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchant_id",
        "merchant_name",
        "region",
        "country_code",
        "platform",
        "segment",
        "currency",
        "storefront_url"
      ],
      "properties": {
        "merchant_id": {
          "type": "string",
          "pattern": "^M\\d{3}$"
        },
        "merchant_name": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "platform": {
          "enum": [
            "shopify",
            "woocommerce",
            "bigcommerce",
            "magento",
            "custom"
          ]
        },
        "segment": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "storefront_url": {
          "type": "string",
          "pattern": "^/store/M\\d{3}/$"
        }
      }
    }
  }
}
