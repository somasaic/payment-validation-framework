{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Products",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "merchant_id",
    "currency",
    "symbol",
    "decimals",
    "items"
  ],
  "properties": {
    "merchant_id": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "symbol": {
      "type": "string"
    },
    "decimals": {
      "type": "integer",
      "enum": [
        0,
        2
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "name",
          "price",
          "currency"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^SKU-\\d{4}$"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      }
    }
  }
}
