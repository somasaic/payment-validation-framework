{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-000000005a1d",
    "name": "Payment Validation API",
    "description": "Contract tests for the merchant, store-locator and validation-runs API. Run with Newman in CI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared JSON Schemas (kept in sync with tests/api/schemas)",
          "pm.collectionVariables.set(\"merchantSchema\", JSON.stringify({",
          "  type: \"object\", additionalProperties: false,",
          "  required: [\"merchant_id\", \"merchant_name\", \"region\", \"country_code\", \"platform\", \"segment\", \"currency\", \"storefront_url\"],",
          "  properties: {",
          "    merchant_id: { type: \"string\", pattern: \"^M\\\\d{3}$\" },",
          "    merchant_name: { type: \"string\", minLength: 1 },",
          "    region: { type: \"string\", pattern: \"^[A-Z]{2}$\" },",
          "    country_code: { type: \"string\", pattern: \"^[A-Z]{2}$\" },",
          "    platform: { enum: [\"shopify\", \"woocommerce\", \"bigcommerce\", \"magento\", \"custom\"] },",
          "    segment: { type: \"string\" },",
          "    currency: { type: \"string\", pattern: \"^[A-Z]{3}$\" },",
          "    storefront_url: { type: \"string\", pattern: \"^/store/M\\\\d{3}/$\" }",
          "  }",
          "}));",
          "pm.collectionVariables.set(\"errorSchema\", JSON.stringify({",
          "  type: \"object\", additionalProperties: false, required: [\"error\"],",
          "  properties: {",
          "    error: {",
          "      type: \"object\", required: [\"code\", \"message\"],",
          "      properties: {",
          "        code: { type: \"string\", pattern: \"^[A-Z_]+$\" },",
          "        message: { type: \"string\", minLength: 1 },",
          "        details: { type: \"array\", items: { type: \"object\", required: [\"field\", \"message\"] } }",
          "      }",
          "    }",
          "  }",
          "}));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds within 2s\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test(\"has X-Request-ID\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "",
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body\", () => pm.expect(pm.response.json()).to.eql({ status: \"ok\", version: \"1.0.0\" }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
