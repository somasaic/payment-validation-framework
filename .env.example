# Copy this file to .env and adjust values for local runs.
# .env is gitignored; variables already set in the environment (e.g. CI) take precedence.

# API key the mock service requires on POST /api/v1/validation-runs (Postman "local" env uses the same value)
MOCK_API_KEY=local-dev-key

# Simulated delays (milliseconds) of the mock sites' async widgets
MOCK_PAYMENT_LATENCY_MS=800
MOCK_SEARCH_LATENCY_MS=600

# Point the test suites at a deployed environment instead of starting the local mock service
# TARGET_BASE_URL=https://staging.example.com
